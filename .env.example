# Configuración de Base de Datos
DB_URL=jdbc:postgresql://vivero-db:5432/vivero_db?serverTimezone=UTC
DB_USER=changeme
DB_PASS=changeme

POSTGRES_USER=changeme
POSTGRES_PASSWORD=changeme
POSTGRES_DB=vivero_db

# Configuración de JWT
# Generar uno propio, nunca reusar este placeholder ni el valor que tenia este archivo antes
# (quedo expuesto en el historial de git -- ver aviso de seguridad). El codigo decodifica esto
# como Base64 (Decoders.BASE64 en JwtUtils.java), no hex -- generar con: openssl rand -base64 64
JWT_SECRET=changeme-generate-a-real-random-secret-yourself
JWT_EXPIRATION_MS=86400000

# Origen(es) permitidos por CORS aparte de localhost -- el dominio real una vez en el VPS
# (ver app.cors.allowed-origins en application.properties).
FRONTEND_URL=https://changeme.example.com

# Solo necesarias para levantar los usuarios sembrados en una base recien creada (DataInitializer):
# Sergio (JEFE, todas las unidades), Pablo (COLEGA, solo Abono), Hernan (ADMIN 2, solo Herramientas).
INITIAL_JEFE_PASSWORD=changeme
INITIAL_COLEGA_PASSWORD=changeme
INITIAL_HERNAN_PASSWORD=changeme
